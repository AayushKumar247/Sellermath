# SellerMath Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env or .env.local to source control

# Backend (Express) - required for AI Insights feature
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend (Express) - optional, defaults to 3001
# PORT=3001

# API Configuration (optional)
# For local development with separate backend:
# VITE_API_URL=http://localhost:3001
#
# For Vercel deployment (monorepo):
# Leave VITE_API_URL empty to use relative paths
# Vercel will route /api/* requests to the Express server automatically
